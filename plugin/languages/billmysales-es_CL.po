#. Plugin Name of the plugin
#. Author of the plugin
#: billmysales.php
msgid "BillMySales"
msgstr "BillMySales"

#. Author URI of the plugin
#: billmysales.php
msgid "https://www.billmysales.com"
msgstr "https://www.billmysales.com"

#. Description of the plugin
#: billmysales.php
msgid "Sends WooCommerce orders to BillMySales when they reach the selected statuses, and adds custom fields to the checkout."
msgstr "Envía los pedidos de WooCommerce a BillMySales cuando llegan a los estados seleccionados, y agrega campos personalizados al checkout."

#: src/Admin/SettingsPage.php:71
#: src/Admin/SettingsPage.php:114
msgid "Settings"
msgstr "Configuración"

#: src/Admin/SettingsPage.php:93
#: src/Admin/SettingsPage.php:166
msgid "Show secret"
msgstr "Mostrar secreto"

#: src/Admin/SettingsPage.php:94
msgid "Hide secret"
msgstr "Ocultar secreto"

#: src/Admin/SettingsPage.php:115
msgid "Checkout fields"
msgstr "Campos del checkout"

#: src/Admin/SettingsPage.php:141
msgid "Orders are sent to BillMySales when they reach one of the selected statuses, signed with the secret."
msgstr "Los pedidos se envían a BillMySales cuando llegan a uno de los estados seleccionados, firmados con el secreto."

#: src/Admin/SettingsPage.php:143
msgid "Set the URL and the secret: no orders are sent until both are saved."
msgstr "Completa la URL y el secreto: no se envían pedidos hasta guardar ambos."

#: src/Admin/SettingsPage.php:149
msgid "Status"
msgstr "Estado"

#: src/Admin/SettingsPage.php:153
msgid "Active"
msgstr "Activo"

#: src/Admin/SettingsPage.php:155
msgid "When unchecked, no orders are sent; the settings are kept."
msgstr "Si se desmarca, no se envían pedidos; la configuración se conserva."

#: src/Admin/SettingsPage.php:159
msgid "Notification URL"
msgstr "URL de notificación"

#: src/Admin/SettingsPage.php:163
msgid "Secret"
msgstr "Secreto"

#: src/Admin/SettingsPage.php:169
msgid "The secret shared with BillMySales, used to sign each notification."
msgstr "El secreto compartido con BillMySales, con el que se firma cada notificación."

#: src/Admin/SettingsPage.php:173
msgid "Statuses that notify"
msgstr "Estados que notifican"

#: src/Admin/SettingsPage.php:181
msgid "An order is sent each time it changes to one of these statuses."
msgstr "Un pedido se envía cada vez que cambia a uno de estos estados."

#: src/Admin/SettingsPage.php:185
msgid "Save settings"
msgstr "Guardar configuración"

#: src/Admin/SettingsPage.php:203
msgid "These fields are added to the checkout (block and classic) and sent to BillMySales with the order."
msgstr "Estos campos se agregan al checkout (por bloques y clásico) y se envían a BillMySales con el pedido."

#: src/Admin/SettingsPage.php:213
msgid "+ Add field"
msgstr "+ Agregar campo"

#: src/Admin/SettingsPage.php:214
msgid "Save fields"
msgstr "Guardar campos"

#: src/Admin/SettingsPage.php:251
msgid "Label"
msgstr "Etiqueta"

#: src/Admin/SettingsPage.php:253
msgid "E.g. RUT, Company name, Business activity"
msgstr "Ej.: RUT, Razón social, Giro"

#. translators: %s: the field's key.
#: src/Admin/SettingsPage.php:258
#, php-format
msgid "Key: %s"
msgstr "Clave: %s"

#: src/Admin/SettingsPage.php:265
msgid "Values"
msgstr "Valores"

#: src/Admin/SettingsPage.php:267
msgid "E.g. Receipt, Invoice"
msgstr "Ej.: Boleta, Factura"

#: src/Admin/SettingsPage.php:268
msgid "Comma-separated values show the field as a list of those options; empty, it is a free text field."
msgstr "Con valores separados por coma, el campo se muestra como una lista de esas opciones; vacío, es un campo de texto libre."

#: src/Admin/SettingsPage.php:272
msgid "Required"
msgstr "Obligatorio"

#: src/Admin/SettingsPage.php:276
msgid "The customer must fill it in to place the order"
msgstr "El cliente debe completarlo para realizar el pedido"

#: src/Admin/SettingsPage.php:282
msgid "Remove this field"
msgstr "Eliminar este campo"

#: src/Checkout/CheckoutFields.php:252
msgid "Billing information"
msgstr "Información de facturación"

#: src/Settings.php:110
msgid "The URL and the secret are required: the settings were not saved."
msgstr "La URL y el secreto son obligatorios: la configuración no se guardó."

#: src/Settings.php:120
msgid "The URL does not use HTTPS: order data will travel unencrypted. Use an https:// URL."
msgstr "La URL no usa HTTPS: los datos de los pedidos viajarán sin cifrar. Usa una URL https://."

#. Plugin URI of the plugin
#: billmysales.php
msgid "https://www.billmysales.com/apps/datasources/woocommerce"
msgstr "https://www.billmysales.com/apps/datasources/woocommerce"

#: src/Webhook/Delivery.php:117
msgid "Send to BillMySales"
msgstr "Enviar a BillMySales"

#: src/Webhook/Delivery.php:134
msgid "BillMySales: sending requested."
msgstr "BillMySales: envío solicitado."

#. translators: %s: result, e.g. "HTTP 200".
#: src/Webhook/Delivery.php:182
#, php-format
msgid "BillMySales: sent (%s)."
msgstr "BillMySales: enviado (%s)."

#. translators: %s: BillMySales' answer, e.g. "HTTP 422: ...".
#: src/Webhook/Delivery.php:188
#, php-format
msgid "BillMySales: rejected (%s). Fix the cause and use \"Send to BillMySales\" in the order actions."
msgstr "BillMySales: rechazado (%s). Corrige la causa y usa \"Enviar a BillMySales\" en las acciones del pedido."

#. translators: 1: the error, 2: retry number, 3: delay, e.g. "5 mins".
#: src/Webhook/Delivery.php:196
#, php-format
msgid "BillMySales: not sent (%1$s), retry %2$d in %3$s."
msgstr "BillMySales: no enviado (%1$s), reintento %2$d en %3$s."

#. translators: %s: the error.
#: src/Webhook/Delivery.php:201
#, php-format
msgid "BillMySales: not sent (%s), no more retries. Use \"Send to BillMySales\" in the order actions to try again."
msgstr "BillMySales: no enviado (%s), sin más reintentos. Usa \"Enviar a BillMySales\" en las acciones del pedido para intentarlo de nuevo."

#: src/Checkout/CheckoutFields.php:86
msgid "Select an option"
msgstr "Selecciona una opción"
