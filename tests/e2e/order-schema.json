{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer"
        },
        "total": {
            "type": [
                "integer",
                "string"
            ]
        },
        "number": {
            "type": [
                "integer",
                "string"
            ]
        },
        "date_created": {
            "type": "string",
            "format": "date-time"
        },
        "status": {
            "type": "string"
        },
        "line_items": {
            "type": "array",
            "minItems": 1
        }
    },
    "required": [
        "id",
        "total",
        "number",
        "date_created"
    ]
}
